<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#E5E7EB">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thanh Toán Hóa Đơn"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <!-- Receipt Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/white"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_logo_heart"
                app:tint="#0D9488"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DERMACARE CLINIC"
                android:textStyle="bold"
                android:textSize="18sp"
                android:gravity="center"
                android:textColor="#115E59"
                android:layout_marginBottom="24dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:text="Phí khám chuyên khoa:"
                    android:textColor="#4B5563"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="150,000 ₫"
                    android:textSize="16sp"
                    android:textColor="#1F2937"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:text="Tiền thuốc:"
                    android:textColor="#4B5563"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="350,000 ₫"
                    android:textSize="16sp"
                    android:textColor="#1F2937"/>
            </LinearLayout>

            <!-- Dashed separator -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layerType="software"
                android:background="@drawable/bg_dashed_line"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tổng thanh toán:"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#1F2937"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="500,000 ₫"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:textColor="#0D9488"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layerType="software"
                android:background="@drawable/bg_dashed_line"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"/>

            <!-- Fake Barcode -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">
                <View android:layout_width="4dp" android:layout_height="match_parent" android:background="#1F2937" android:layout_marginEnd="2dp"/>
                <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#1F2937" android:layout_marginEnd="4dp"/>
                <View android:layout_width="6dp" android:layout_height="match_parent" android:background="#1F2937" android:layout_marginEnd="2dp"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#1F2937" android:layout_marginEnd="6dp"/>
                <View android:layout_width="3dp" android:layout_height="match_parent" android:background="#1F2937" android:layout_marginEnd="2dp"/>
                <View android:layout_width="8dp" android:layout_height="match_parent" android:background="#1F2937" android:layout_marginEnd="4dp"/>
                <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#1F2937" android:layout_marginEnd="2dp"/>
                <View android:layout_width="5dp" android:layout_height="match_parent" android:background="#1F2937" android:layout_marginEnd="6dp"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#1F2937" android:layout_marginEnd="2dp"/>
                <View android:layout_width="4dp" android:layout_height="match_parent" android:background="#1F2937" android:layout_marginEnd="4dp"/>
                <View android:layout_width="3dp" android:layout_height="match_parent" android:background="#1F2937" android:layout_marginEnd="2dp"/>
                <View android:layout_width="7dp" android:layout_height="match_parent" />
            </LinearLayout>
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INV-20231024-8890"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:letterSpacing="0.2"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phương thức thanh toán:"
            android:textStyle="bold"
            android:textColor="#374151"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>
            
        <RadioButton
            android:id="@+id/rbCash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@drawable/bg_rounded_radio"
            android:text="Tiền mặt"
            android:textColor="#1F2937"
            android:buttonTint="#0D9488"
            android:checked="true"
            android:layout_marginBottom="8dp"/>
            
        <RadioButton
            android:id="@+id/rbVNPay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@drawable/bg_rounded_radio"
            android:text="VNPay (Quét mã QR)"
            android:textColor="#1F2937"
            android:buttonTint="#0D9488"/>
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmPayment"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="Xác nhận &amp; In hóa đơn"
        app:cornerRadius="32dp"
        android:backgroundTint="#0D9488"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="18sp" 
        app:elevation="8dp"/>

</LinearLayout>
