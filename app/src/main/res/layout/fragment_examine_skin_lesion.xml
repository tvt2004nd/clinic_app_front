<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Khám tổn thương da"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:letterSpacing="-0.02"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Khai thác triệu chứng &amp; mô tả tổn thương thực thể"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:layout_marginBottom="20dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Triệu chứng cơ năng"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bệnh nhân cảm thấy gì?"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="14dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxStrokeColor="@color/primary"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/primary"
                    app:boxBackgroundColor="@color/background"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.DermaCare.Medium">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtMainComplaint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Triệu chứng chính *"
                        android:minLines="3"
                        android:gravity="top|start"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        app:boxBackgroundColor="@color/background"
                        app:boxStrokeColor="@color/primary"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.DermaCare.Medium"
                        android:hint="Mức độ ngứa">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actItchingLevel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        app:boxBackgroundColor="@color/background"
                        app:boxStrokeColor="@color/primary"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.DermaCare.Medium"
                        android:hint="Cảm giác kèm theo">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actAssociatedSensation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxStrokeColor="@color/primary"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/primary"
                    app:boxBackgroundColor="@color/background"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.DermaCare.Medium">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtSymptomDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Thời gian tiến triển (vd: 2 tuần, 1 tháng...)"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxStrokeColor="@color/primary"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/primary"
                    app:boxBackgroundColor="@color/background"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.DermaCare.Medium">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtProgression"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Diễn tiến (tăng dần, giảm dần, không đổi...)"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Khám tổn thương da"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mô tả chi tiết tổn thương thực thể"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="14dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:boxBackgroundColor="@color/background"
                    app:boxStrokeColor="@color/primary"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.DermaCare.Medium"
                    android:hint="Loại tổn thương *">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actLesionType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        app:boxBackgroundColor="@color/background"
                        app:boxStrokeColor="@color/primary"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.DermaCare.Medium">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtLesionLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Vị trí"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        app:boxBackgroundColor="@color/background"
                        app:boxStrokeColor="@color/primary"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.DermaCare.Medium">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtLesionSize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Kích thước"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        app:boxBackgroundColor="@color/background"
                        app:boxStrokeColor="@color/primary"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.DermaCare.Medium"
                        android:hint="Màu sắc">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actLesionColor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        app:boxBackgroundColor="@color/background"
                        app:boxStrokeColor="@color/primary"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.DermaCare.Medium"
                        android:hint="Bề mặt">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actLesionSurface"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxStrokeColor="@color/primary"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/primary"
                    app:boxBackgroundColor="@color/background"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.DermaCare.Medium">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtSpecialSigns"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Dấu hiệu đặc biệt (Darier, Koebner, vảy...)"
                        android:minLines="2"
                        android:gravity="top|start"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border"
                    android:layout_marginVertical="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ảnh tổn thương"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chụp ảnh tổn thương da để lưu hồ sơ"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:id="@+id/photoGallery"
                        android:layout_width="wrap_content"
                        android:layout_height="80dp"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTakePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Chụp ảnh tổn thương"
                    android:textSize="14sp"
                    app:cornerRadius="24dp"
                    app:backgroundTint="@color/primary_soft"
                    android:textColor="@color/primary"
                    app:icon="@android:drawable/ic_menu_camera"
                    app:iconTint="@color/primary"
                    app:elevation="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickGallery"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Chọn ảnh từ thư viện"
                    android:textSize="14sp"
                    app:cornerRadius="24dp"
                    app:backgroundTint="@color/primary_soft"
                    android:textColor="@color/primary"
                    app:iconGravity="textStart"
                    app:icon="@drawable/ic_gallery"
                    app:iconTint="@color/primary"
                    app:elevation="0dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Yếu tố liên quan"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="14dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxStrokeColor="@color/primary"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/primary"
                    app:boxBackgroundColor="@color/background"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.DermaCare.Medium">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtTriggers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Yếu tố liên quan (ánh nắng, mỹ phẩm, dị ứng...)"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxStrokeColor="@color/primary"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/primary"
                    app:boxBackgroundColor="@color/background"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.DermaCare.Medium">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtPreviousTreatment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:hint="Đã điều trị gì trước đây?"
                        android:minLines="2"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxStrokeColor="@color/primary"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/primary"
                    app:boxBackgroundColor="@color/background"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.DermaCare.Medium">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtExtraNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:hint="Nhận xét thêm"
                        android:minLines="2"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
