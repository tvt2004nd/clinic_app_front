<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chẩn đoán cuối cùng"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:letterSpacing="-0.02"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chẩn đoán dựa trên tổn thương da đã khám"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:layout_marginBottom="20dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chẩn đoán"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="10dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxStrokeColor="@color/primary"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/primary"
                    app:boxBackgroundColor="@color/background"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.DermaCare.Medium">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtDiseaseName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Chẩn đoán chính *"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:boxBackgroundColor="@color/background"
                    app:boxStrokeColor="@color/primary"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.DermaCare.Medium"
                    android:hint="Mức độ nặng">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actSeverity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:boxBackgroundColor="@color/background"
                    app:boxStrokeColor="@color/primary"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.DermaCare.Medium"
                    android:hint="Loại chẩn đoán">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actDiagnosisType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxStrokeColor="@color/primary"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/primary"
                    app:boxBackgroundColor="@color/background"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.DermaCare.Medium">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtDifferentialDiagnosis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Chẩn đoán phân biệt"
                        android:minLines="2"
                        android:gravity="top|start"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hướng dẫn điều trị"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="10dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:boxStrokeColor="@color/primary"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/primary"
                    app:boxBackgroundColor="@color/background"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.DermaCare.Medium">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtTreatmentPlan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Hướng dẫn điều trị"
                        android:minLines="3"
                        android:gravity="top|start"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxStrokeColor="@color/primary"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/primary"
                    app:boxBackgroundColor="@color/background"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.DermaCare.Medium">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtDiagnosisNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ghi chú"
                        android:minLines="3"
                        android:gravity="top|start"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
